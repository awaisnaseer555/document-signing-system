PORT=3001

# Comma-separated browser origins for CORS (no trailing slash)
# Must match the exact URL users open in the browser.
# Local:
FRONTEND_ORIGIN=http://localhost:3000
# Railway / Vercel API — origin ONLY (no /login or trailing path):
# FRONTEND_ORIGIN=https://document-signing-system-six.vercel.app
# Both local + production:
# FRONTEND_ORIGIN=http://localhost:3000,https://document-signing-system-six.vercel.app

# Supabase (backend / Vercel API project only — never put SERVICE_ROLE in the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
