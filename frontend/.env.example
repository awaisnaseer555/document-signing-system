NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Local NestJS
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Production (Next.js Vercel project) — use your NestJS Vercel URL + /api
# Example after deploying backend as a separate Vercel project:
# NEXT_PUBLIC_API_URL=https://your-api-project.vercel.app/api
#
# Do NOT use localhost on Vercel (causes "Failed to fetch" after login).
# Do NOT put SUPABASE_SERVICE_ROLE_KEY in the frontend.
